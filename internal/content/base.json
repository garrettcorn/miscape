  "quests": [
    {"id": "lights_for_wickhollow", "name": "Lights for Manchester", "giver": "mabel",
     "intro": "A new face! Since Mr Arkwright's mill went up on Miller Street, this town never sleeps, and my lamps never stay lit. Boggarts have been at the lamp posts again. Fetch me some timber, make yourself a sword, and see off a few of the creatures.",
     "outro": "You'll do nicely. Here's your pay, and some copper toward a lantern of your own.",
     "steps": [
       {"kind": "gather", "target": "log", "count": 4, "text": "Chop 4 logs in the countryside"},
       {"kind": "craft", "target": "wooden_sword", "count": 1, "text": "Craft a Wooden Sword"},
       {"kind": "kill", "target": "bramblet", "count": 3, "text": "See off 3 boggarts"}
     ],
     "reward": {"coins": 25, "items": {"copper_ore": 2, "berry": 3}, "xp": {"combat": 40, "crafting": 30}}},
    {"id": "what_glimmers_below", "name": "Lights on the Moors", "giver": "ott", "requires": "lights_for_wickhollow",
     "intro": "North of here the road runs up to the Highland moors. Lights dance there at night: will-o'-the-wisps, leading travellers into the bogs. Bring me 3 wisp-light shards and I'll know you can look after yourself. Carry a lantern, and if it goes badly, your Hearth Lantern will bring you home.",
     "outro": "Back in one piece, and with your pockets glowing. Take this token, and my thanks.",
     "steps": [
       {"kind": "deliver", "target": "glimmer_shard", "count": 3, "text": "Bring 3 wisp-light shards to Ottiwell"}
     ],
     "reward": {"coins": 80, "items": {"warden_token": 1}, "xp": {"mining": 60, "combat": 60}}}
  ],
  "shop": [
