     ],
     "reward": {"coins": 25, "items": {"copper_ore": 2, "berry": 3}, "xp": {"combat": 40, "crafting": 30}}},
    {"id": "what_glimmers_below", "name": "What Glimmers Below", "giver": "ott", "requires": "lights_for_wickhollow",
     "intro": "Past this gate the Gloam begins. It's dim, and the wisps don't care for visitors. Bring me 3 Glimmer Shards and I'll know you can handle yourself. Carry a lantern — and if it gets bad, use your Hearth Lantern to come home.",
     "outro": "Well done. Not many come back with their pockets glowing. Take this token, and my thanks.",
     "steps": [
       {"kind": "deliver", "target": "glimmer_shard", "count": 3, "text": "Bring 3 Glimmer Shards to Ott"}
